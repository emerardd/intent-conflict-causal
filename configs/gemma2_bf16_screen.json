{
  "experiment_name": "gemma2_2b_bf16_authorization_screen",
  "dataset_version": "stage2_neutral",
  "mode": "screen",
  "require_behavior_gate": true,
  "model_name": "google/gemma-2-2b-it",
  "model_loader": "causal_lm",
  "local_files_only": true,
  "allow_fallback_chat_template": false,
  "system_role_policy": "merge_into_user",
  "device": "cuda",
  "dtype": "bfloat16",
  "quantization": "none",
  "enable_thinking": false,
  "layers": [0, 3, 6, 9, 12, 15, 18, 21, 25],
  "max_scenarios": 6,
  "train_scenario_count": 3,
  "validation_scenario_count": 1,
  "permutations": 500,
  "random_controls": 5,
  "output_path": "results/gemma2_bf16_screen.json",
  "activation_output_path": "results/gemma2_bf16_screen_activations.npz",
  "plot_dir": "plots/gemma2_bf16_screen",
  "seed": 42
}
