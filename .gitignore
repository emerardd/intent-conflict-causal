# --- Raw experiment artifacts ----------------------------------------------
# results/ IS tracked: prompts, baselines, interventions, activations, frozen
# axes, environment dumps, source snapshots and manifest hashes ship with the
# repository so scripts/audit_stage*.py can be run by anyone, without a GPU.
# See docs/output-layout.md.
#
# Only the regenerable figure directory is excluded; the figures the reports
# embed are checked in under docs/figures/.
plots/

# Model weights and tokenizer caches (multi-GB, fetched from the Hub)
models/

